# Database Configuration
DATABASE_URL="postgresql://username:password@host:port/database?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://username:password@host:port/database"
# Protocol sync and admin rebuilds take session advisory locks on DIRECT_URL.
# Session mode (port 5432, including *.pooler.supabase.com:5432 and db.<ref>:5432)
# can hold those locks. The transaction pooler (port 6543 / pgbouncer=true) cannot.
# Ordinary Prisma queries still use DATABASE_URL.

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
# AI Gateway. Leave unset to use Vercel OIDC.
# AI_GATEWAY_API_KEY=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# PostHog analytics (EU Cloud)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Google Ads / GA4 (optional overrides — defaults match production tags in components/google-tag.tsx)
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-16864609071
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-PYK62LTZRQ
# Conversion send_to from Google Ads → Conversions → Tag setup (AW-XXXX/LABEL).
# Required for event-snippet Sign-up / Subscribe; leave unset until labels are pasted.
# NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_SEND_TO=AW-16864609071/YOUR_SIGNUP_LABEL
# NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_SEND_TO=AW-16864609071/YOUR_PURCHASE_LABEL

# Local dashboard auth bypass (development/self-host only — never enable in production)
# LOCAL_DASHBOARD_AUTH_BYPASS=true
# NEXT_PUBLIC_LOCAL_DASHBOARD_AUTH_BYPASS=true
# LOCAL_DASHBOARD_USER_ID=local-dashboard-user
# NEXT_PUBLIC_LOCAL_DASHBOARD_USER_ID=local-dashboard-user
# LOCAL_DASHBOARD_USER_EMAIL=local-dashboard@deltalytix.local
# NEXT_PUBLIC_LOCAL_DASHBOARD_USER_EMAIL=local-dashboard@deltalytix.local
# LOCAL_DASHBOARD_AUTH_BYPASS_ALLOW_PRODUCTION=1

# Discord Configuration
DISCORD_SECRET=your_discord_secret_here
DISCORD_ID=your_discord_id_here
REDIRECT_URL='http://localhost:3000/api/auth/callback'

# Security — AES-256-GCM key for Connection.token at rest (server-only, never NEXT_PUBLIC_)
# Generate: openssl rand -hex 32
# Any non-placeholder string also works (hashed with SHA-256). Required in production for broker sync.
ENCRYPTION_KEY=your_encryption_key_here

# Email Service
RESEND_API_KEY=your_resend_api_key_here

# Scheduled jobs (Vercel Schedules → private function targets)
# Production runs them when VERCEL_ENV=production and VERCEL_TARGET_ENV=production.
# Self-host / local: schedule handlers return 403 (not on Vercel). Use your own
# trigger (systemd timer, external cron) against admin routes if you need the jobs.
# Preview / dedicated envs: set ALLOW_SCHEDULED_JOBS=<VERCEL_TARGET_ENV> only on a
# database that is NOT shared with production. Never set this on beta.
# ALLOW_SCHEDULED_JOBS=preview
#
# CRON_SECRET: keep for ~2 weeks after promoting this PR so a rollback to the
# previous Bearer-auth handlers still verifies. Rotate (do not delete) after the
# rollback window. New schedule handlers do not read CRON_SECRET.
# CRON_SECRET=

# GitHub Configuration
GITHUB_TOKEN=your_github_token_here

# Optional: Jina Reader API key for Investing.com calendar cron
# (raises rate limits for https://r.jina.ai/ fetches of sslecal2.investing.com)
# JINA_API_KEY=your_jina_api_key_here

# Public URLs
NEXT_PUBLIC_DISCORD_INVITATION="https://discord.gg/your_invitation_link"
NEXT_PUBLIC_REPO_OWNER="your_github_username"
NEXT_PUBLIC_REPO_NAME="your_repo_name"

# Support Emails (from address must use the Resend-verified eu.updates.deltalytix.app domain)
SUPPORT_TEAM_EMAIL='support-team@example.com'
SUPPORT_EMAIL='support@eu.updates.deltalytix.app'

# Tutorial Videos
NEXT_PUBLIC_RITHMIC_PERFORMANCE_TUTORIAL_VIDEO='your_video_url_here'
NEXT_PUBLIC_RITHMIC_ORDER_TUTORIAL_VIDEO='your_video_url_here'
# R | Protocol API (server-side sync). Default app name must match your Rithmic Protocol conformance.
# Default connect point offered in the UI: core | nyc | colo75 | br | ie | de | za | in | sg | hk | kr | jp | au | test
# RITHMIC_PROTOCOL_GATEWAY=core
# Full URI override (wins over RITHMIC_PROTOCOL_GATEWAY); use for UAT or a local proxy
# RITHMIC_PROTOCOL_URI=wss://rituz00100.rithmic.com:443
# Show the Rithmic Test (UAT) connect point in the UI — defaults to true outside production
# RITHMIC_PROTOCOL_ALLOW_TEST_GATEWAY=true
# RITHMIC_PROTOCOL_APP_NAME=DeltalytixRithmicProtocolAPI
# RITHMIC_PROTOCOL_APP_VERSION=0.1.0
# RITHMIC_PROTOCOL_HISTORY_LOOKBACK_DAYS=30 # fallback only when a connection has no account start date
#
# Live Protocol e2e (`bun run test:e2e:rithmic` / GitHub Actions).
# GitHub repository secrets: USERNAME + PASSWORD only. Defaults: Core + Paper Trading.
# RITHMIC_PROTOCOL_E2E_USERNAME=
# RITHMIC_PROTOCOL_E2E_PASSWORD=
# RITHMIC_PROTOCOL_E2E_SYSTEM_NAME=Rithmic Paper Trading
# RITHMIC_PROTOCOL_E2E_GATEWAY=core
# RITHMIC_PROTOCOL_E2E_ACCOUNT_ID=
NEXT_PUBLIC_NINJATRADER_PERFORMANCE_TUTORIAL_VIDEO='your_video_url_here'

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY='your_stripe_publishable_key_here'
STRIPE_SECRET_KEY='your_stripe_secret_key_here'
STRIPE_WEBHOOK_SECRET='your_stripe_webhook_secret_here'
# Optional: auto-apply a Plus Checkout discount per interval + currency. Empty = off.
# Unsuffixed keys are USD promotion_code ids. EUR uses the *_EUR keys.
STRIPE_BTW_MONTHLY_PROMO=
STRIPE_BTW_QUARTERLY_PROMO=
STRIPE_BTW_YEARLY_PROMO=
# Live EUR (set these on Vercel production + preview; do not commit filled values):
# STRIPE_BTW_MONTHLY_PROMO_EUR=promo_1UCdjtCgu8zCkThCaRPGy5Nj   # WORK10EUR, €10 off
# STRIPE_BTW_QUARTERLY_PROMO_EUR=promo_1UCdjuCgu8zCkThCUq9dJh42 # WORK15EUR, €30 off
# STRIPE_BTW_YEARLY_PROMO_EUR=promo_1UCdjuCgu8zCkThCjeCfEwV8    # WORK50EUR, €70 off
STRIPE_BTW_MONTHLY_PROMO_EUR=
STRIPE_BTW_QUARTERLY_PROMO_EUR=
STRIPE_BTW_YEARLY_PROMO_EUR=
# Black Friday / Cyber Week auto-apply. Empty = off for that plan.
# The app date-gates these in Europe/Paris. While either window is active,
# Checkout does not fall back to STRIPE_BTW_*. Outside both windows, Back to
# Work still applies when those vars are set.
# Lifetime: 2026-11-27 00:00:00 through 2026-11-30 23:59:59 Europe/Paris.
#   plus_lifetime_usd / plus_lifetime_eur only, list $300 / €300.
#   Sale is $100 / €100 off the $300 / €300 list (final price $200 / 200 €).
# Three plans: 2026-12-01 00:00:00 through 2026-12-14 23:59:59 Europe/Paris.
#   Final sale prices: monthly $5 / €5, quarterly $15 / €15, yearly $50 / €50
#   ($14.99 / $30 / $70 off the $19.99 / $45 / $120 list).
# Unsuffixed keys are USD promotion_code ids. EUR uses the *_EUR keys.
# Set the ids on Vercel beta and production. Do not commit them here.
STRIPE_BF_LIFETIME_PROMO=
STRIPE_BF_LIFETIME_PROMO_EUR=
STRIPE_BF_MONTHLY_PROMO=
STRIPE_BF_MONTHLY_PROMO_EUR=
STRIPE_BF_QUARTERLY_PROMO=
STRIPE_BF_QUARTERLY_PROMO_EUR=
STRIPE_BF_YEARLY_PROMO=
STRIPE_BF_YEARLY_PROMO_EUR=

# Interactive Brokers Flex Web Service
# No app-level credentials: each user supplies their own Flex token + query ID.
# Overrides below are only needed to point at a different host or tune polling.
# IBKR_FLEX_BASE_URL='https://ndcdyn.interactivebrokers.com/AccountManagement/FlexWebService'
# IBKR requires a User-Agent on every request
# IBKR_FLEX_USER_AGENT='Deltalytix/1.0'
# Delay between GetStatement polls while IBKR generates the report (default 3000)
# IBKR_FLEX_POLL_DELAY_MS=3000
# How many times to poll before giving up (default 5)
# IBKR_FLEX_MAX_ATTEMPTS=5
# Per-request timeout in ms (default 30000)
# IBKR_FLEX_TIMEOUT_MS=30000
# Deep link shown in the setup guide (defaults to the Client Portal home)
# NEXT_PUBLIC_IBKR_FLEX_PORTAL_URL='https://www.interactivebrokers.com/portal'
# NEXT_PUBLIC_IBKR_SYNC_TUTORIAL_VIDEO='your_video_url_here'

# DxFeed Configuration
DXFEED_AUTH_URL='https://authdxfeed.volumetricatrading.com/api/auth/token'
DXFEED_PLATFORM_KEY='your_dxfeed_platform_key_here'
# 0=Production, 1=Staging/demo (defaults to 0 in production, 1 otherwise)
# DXFEED_ENVIRONMENT=0
# Hours until a DxFeed report token is treated as expired when the API does not send JWT exp (default 12)
# DXFEED_TOKEN_TTL_HOURS=12
